# Dockerfile for testing CI build locally
FROM ubuntu:24.04

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies (matching CI)
RUN apt-get update && apt-get install -y \
    libgirepository1.0-dev \
    libgirepository-2.0-dev \
    libcairo2-dev \
    gobject-introspection \
    gir1.2-gtk-4.0 \
    gir1.2-adw-1 \
    python3-dev \
    pkg-config \
    python3-pip \
    git \
    curl \
    build-essential \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Set working directory
WORKDIR /workspace

# Copy project files
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY tests/ ./tests/

# Set PKG_CONFIG_PATH
ENV PKG_CONFIG_PATH=/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/lib/pkgconfig

# Try to sync dependencies
RUN uv sync --all-extras

# Run tests
CMD ["uv", "run", "pytest", "tests/", "-v", "--tb=short"]
